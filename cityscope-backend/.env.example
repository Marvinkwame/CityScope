# PostgreSQL + PostGIS connection string
# Local: postgres://user:password@localhost:5432/cityscope
# Neon: copy the connection string from your Neon project's dashboard
DATABASE_URL=postgres://user:password@localhost:5432/cityscope

# Server port (Render sets this automatically in production — leave as 3001 for local)
PORT=3001

# Allowed CORS origin — set to your Vercel frontend URL in production
# Local development uses http://localhost:5173 as the default fallback
CORS_ORIGIN=https://your-app.vercel.app

# A label for the database a writing script is about to change, e.g. local, reach-dev, production.
# Writing scripts (migrate, seed:*, reach:build, reach:calibrate, reach:publish, reach:check-gp)
# refuse to run while it is empty, and print it with the database host before connecting.
# It is only a label: nothing checks it against DATABASE_URL, so read the printed host.
# For a local database, set CITYSCOPE_DB_TARGET=local here. For any other target, leave it blank
# and set it on the command line for that run, e.g. CITYSCOPE_DB_TARGET=production npm run ...
CITYSCOPE_DB_TARGET=

# A script-only Mapbox token for reach:calibrate (walking isochrones). Never the frontend's public token.
MAPBOX_TOKEN=
