# PostgreSQL connection string
# Local: postgres://user:password@localhost:5432/cityscope
# Railway: copy from your Railway Postgres service dashboard
DATABASE_URL=postgres://user:password@localhost:5432/cityscope

# Server port (Railway sets this automatically — leave as 3001 for local)
PORT=3001

# Allowed CORS origin — set to your Vercel frontend URL in production
# Local development uses http://localhost:5173 as the default fallback
CORS_ORIGIN=https://your-app.vercel.app
