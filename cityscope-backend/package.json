{
  "name": "cityscope-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:cities": "tsx src/scripts/seed-cities.ts",
    "seed:pois": "tsx src/scripts/seed-pois.ts",
    "seed:parks": "tsx src/scripts/seed-parks.ts",
    "seed:all": "tsx src/scripts/seed-all.ts",
    "fetch:pois": "tsx src/scripts/fetch-pois.ts",
    "fetch:parks": "tsx src/scripts/fetch-parks.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "reach:build": "tsx src/scripts/build-reach.ts",
    "reach:calibrate": "tsx src/scripts/calibrate-reach.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "geotiff": "3.0.5",
    "h3-js": "4.5.0",
    "osmtogeojson": "3.0.0-beta.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
